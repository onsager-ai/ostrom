[Unit]
Description=Ostrom Management Platform
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/ostrom-platform serve --hosts-config %E/ostrom/platform-hosts.json --socket %t/ostrom/platform.sock
Nice=10
MemoryMax=256M
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
